<script>
jQuery(document).ready(function(){

// PHP condition for button text
var prevText = 'पिछला';
var nextText = 'अगला';

// Initialize the slider
var $slider = jQuery('.customer-logos');

$slider.slick({
slidesToShow: 6,
slidesToScroll: 1,
autoplay: true,
autoplaySpeed: 1500,
dots: true,
pauseOnHover: false,
arrows: true,

prevArrow: '<button type="button" class="slick-prev-logo">' + prevText + '</button>',
nextArrow: '<button type="button" class="slick-next-logo">' + nextText + '</button>',

responsive: [
{ breakpoint: 768, settings: { slidesToShow: 4 } },
{ breakpoint: 520, settings: { slidesToShow: 3 } }
]
});

// Pause button
jQuery('.btn-pause').on('click', function() {
$slider.slick('slickPause');
jQuery(this).css('color', '#ffb400');
jQuery('.btn-play').css('color', '#fff');
});

// Play button
jQuery('.btn-play').on('click', function() {
$slider.slick('slickPlay');
jQuery(this).css('color', '#ffb400');
jQuery('.btn-pause').css('color', '#fff');
});

});
</script>
<script>
