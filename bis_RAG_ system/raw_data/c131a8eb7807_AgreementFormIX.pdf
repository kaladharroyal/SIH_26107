<script>
document.addEventListener("DOMContentLoaded", function(){

let speed = 0.4;
let running = true;

/* Select all scrolling elements */
const marquees = document.querySelectorAll('.marquee-with-options ul, .scrolling-2');

marquees.forEach(function(marquee){

let position = 0;

/* Duplicate content if only one line (for looping) */
if(marquee.classList.contains('scrolling-2')){
marquee.innerHTML = marquee.innerHTML + "&nbsp;&nbsp;&nbsp;&nbsp;" + marquee.innerHTML;
}

function scrollTicker(){
if(running){
position -= speed;

/* Reset position for infinite loop */
if(Math.abs(position) >= marquee.scrollWidth / 2){
position = 0;
}

marquee.style.transform = "translateX("+position+"px)";
}

requestAnimationFrame(scrollTicker);
}

scrollTicker();

/* Hover Pause */

const container = marquee.closest('.marquee-with-options, .scrolling-limit');

if(container){
container.addEventListener("mouseenter", function(){
running = false;
});

container.addEventListener("mouseleave", function(){
running = true;
});
}

});


/* PLAY BUTTONS */

document.querySelectorAll("#playBtn, #playBtn2").forEach(btn=>{
btn.addEventListener("click", function(e){
e.preventDefault();
running = true;
});
});


/* PAUSE BUTTONS */

document.querySelectorAll("#pauseBtn, #pauseBtn2").forEach(btn=>{
btn.addEventListener("click", function(e){
e.preventDefault();
running = false;
});
});

});
</script>
<script>
document.addEventListener("DOMContentLoaded", function () {

const galleries = document.querySelectorAll('.youtube-gallery');
const pauseBtns = document.querySelectorAll('.btn-pause');
const playBtns = document.querySelectorAll('.btn-play');
const nextBtns = document.querySelectorAll('.yt-next');
const prevBtns = document.querySelectorAll('.yt-prev');

galleries.forEach((gallery, index) => {

let autoSlide;

function getScrollAmount(){
return gallery.querySelector('.video-card').offsetWidth + 20;
}

function startAutoSlide(){
autoSlide = setInterval(function(){

gallery.scrollBy({
left: getScrollAmount(),
behavior:'smooth'
});

if(gallery.scrollLeft + gallery.clientWidth >= gallery.scrollWidth){
gallery.scrollTo({ left:0, behavior:'smooth' });
}

},3000);
}

function stopAutoSlide(){
clearInterval(autoSlide);
}

/* START */
startAutoSlide();

/* NEXT */
if(nextBtns[index]){
nextBtns[index].onclick = () =>{
gallery.scrollBy({
left: getScrollAmount(),
behavior:'smooth'
});
};
}

/* PREV */
if(prevBtns[index]){
prevBtns[index].onclick = () =>{
gallery.scrollBy({
left: -getScrollAmount(),
behavior:'smooth'
});
};
}

/* PAUSE */
if(pauseBtns[index]){
pauseBtns[index].addEventListener("click", function(){
stopAutoSlide();
pauseBtns[index].classList.add("active-gallery");
playBtns[index].classList.remove("active-gallery");
});
}

/* PLAY */
if(playBtns[index]){
playBtns[index].addEventListener("click", function(){
startAutoSlide();
playBtns[index].classList.add("active-gallery");
pauseBtns[index].classList.remove("active-gallery");
});
}

/* HOVER PAUSE */
gallery.addEventListener("mouseenter", stopAutoSlide);

gallery.addEventListener("mouseleave", function(){
if(playBtns[index].classList.contains("active-gallery")){
startAutoSlide();
}
});

});

});
</script>

<script>
"use strict";

// Select elements
const slides = document.querySelectorAll(".slide-2024");
const dotsContainer = document.querySelector(".dots");
const nextBtn = document.querySelector(".btn-next");
const prevBtn = document.querySelector(".btn-prev");

// State
let curSlide = 0;

// ================= INIT =================

// Set initial slide positions + create dots
slides.forEach((slide, indx) => {
slide.style.transform = `translateX(${indx * 100}%)`;

const dot = document.createElement("div");
dot.classList.add("dot");

dot.addEventListener("click", () => {
goToSlide(indx);
restartVideo();
});

dotsContainer.appendChild(dot);
});

// ================= FUNCTIONS =================

// Go to specific slide
function goToSlide(slideIndex) {
curSlide = slideIndex;
updateSlider();
}

// Update slider UI
function updateSlider() {
slides.forEach((slide, indx) => {
slide.style.transform = `translateX(${100 * (indx - curSlide)}%)`;
});

// Update active dot
const dots = document.querySelectorAll(".dot");
dots.forEach((dot, indx) => {
dot.classList.toggle("active", indx === curSlide);
});
}

// Next slide
function nextSlide() {
curSlide = (curSlide + 1) % slides.length;
updateSlider();
restartVideo();
}

// Previous slide
function prevSlide() {
curSlide = (curSlide - 1 + slides.length) % slides.length;
updateSlider();
restartVideo();
}

// ================= EVENTS =================

nextBtn.addEventListener("click", nextSlide);
prevBtn.addEventListener("click", prevSlide);

// ================= VIDEO CONTROL =================

function restartVideo() {
const video = document.querySelector(".loop-video");
if (video) {
video.currentTime = 0;
video.play();
}
}

// Start first video
restartVideo();

</script>

<script>
"use strict";

function initializeSlider(containerClass) {

const slides = document.querySelectorAll(`.${containerClass} .slideMobile-2024`);
const dotsContainer = document.querySelector(`.${containerClass} .dots`);
const nextBtn = document.querySelector(`.${containerClass} .btn-next-mobile`);
const prevBtn = document.querySelector(`.${containerClass} .btn-prev-mobile`);

let curSlide = 0;

// setup slides + dots
slides.forEach((slide, indx) => {
slide.style.transform = `translateX(${indx * 100}%)`;

const dot = document.createElement("div");
dot.classList.add("dot");

dot.addEventListener("click", () => goToSlide(indx));
dotsContainer.appendChild(dot);
});

function goToSlide(slideIndex) {
curSlide = slideIndex;
updateSlider();
restartVideo();
}

function updateSlider() {
slides.forEach((slide, indx) => {
slide.style.transform = `translateX(${100 * (indx - curSlide)}%)`;
});

const dots = document.querySelectorAll(`.${containerClass} .dot`);
dots.forEach((dot, indx) => {
dot.classList.toggle("active", indx === curSlide);
});
}

function nextSlide() {
curSlide = (curSlide + 1) % slides.length;
updateSlider();
restartVideo();
}

function prevSlide() {
curSlide = (curSlide - 1 + slides.length) % slides.length;
updateSlider();
restartVideo();
}

nextBtn.addEventListener("click", nextSlide);
prevBtn.addEventListener("click", prevSlide);

// Restart video manually when slide changes
function restartVideo() {
const videos = document.querySelectorAll(`.${containerClass} .loop-video`);
videos.forEach(video => {
video.currentTime = 0;
video.play();
});
}

// Initial load
updateSlider();
restartVideo();
}

// Initialize WITHOUT autoplay interval
initializeSlider("sliderMobile-2024");

</script>

<script>
"use strict";

// Select elements
const slides = document.querySelectorAll(".slide-2024");
const dotsContainer = document.querySelector(".dots");
const nextBtn = document.querySelector(".btn-next");
const prevBtn = document.querySelector(".btn-prev");

// State
let curSlide = 0;

// ================= INIT =================

// Set initial slide positions + create dots
slides.forEach((slide, indx) => {
slide.style.transform = `translateX(${indx * 100}%)`;

const dot = document.createElement("div");
dot.classList.add("dot");

dot.addEventListener("click", () => {
goToSlide(indx);
restartVideo();
});

dotsContainer.appendChild(dot);
});

// ================= FUNCTIONS =================

// Go to specific slide
function goToSlide(slideIndex) {
curSlide = slideIndex;
updateSlider();
}

// Update slider UI
function updateSlider() {
slides.forEach((slide, indx) => {
slide.style.transform = `translateX(${100 * (indx - curSlide)}%)`;
});

// Update active dot
const dots = document.querySelectorAll(".dot");
dots.forEach((dot, indx) => {
dot.classList.toggle("active", indx === curSlide);
});
}

// Next slide
function nextSlide() {
curSlide = (curSlide + 1) % slides.length;
updateSlider();
restartVideo();
}

// Previous slide
function prevSlide() {
curSlide = (curSlide - 1 + slides.length) % slides.length;
updateSlider();
restartVideo();
}

// ================= EVENTS =================

nextBtn.addEventListener("click", nextSlide);
prevBtn.addEventListener("click", prevSlide);

// ================= VIDEO CONTROL =================

function restartVideo() {
const video = document.querySelector(".loop-video");
if (video) {
video.currentTime = 0;
video.play();
}
}

// Start first video
restartVideo();

</script>
<script type="text/javascript" src="https://www.bis.gov.in/wp-content/themes/bisnew/js/ui/jquery-ui.js"></script>
<script>  
$('#cat_icon').click(function () {  
$('#cat_icon').fadeIn(function () {
$('#categories').toggle('slide', {
direction: 'left'
}, 1000);
});
$('.panel_title_left').css('display','block'); 
$('#cat_icon').css('display','none');
}); 
$('.panel_title').click(function () {

$('.panel_title_left').css('display','none'); 
$('#cat_icon').css('display','block'); 
$('#cat_icon').fadeIn(function () {

$('#categories').toggle('slide', {
direction: 'left'
}, 1000);
});
}); 
</script>
<script>  
$('#cat_icon1').click(function () {  
$('#cat_icon1').fadeIn(function () {
$('#categories1').toggle('slide', {
direction: 'right'
}, 1000);
});
$('.panel_title_right').css('display','block'); 
$('#cat_icon1').css('display','none');
}); 
$('.panel_title1').click(function () {
$('.panel_title_right').css('display','none');
$('#cat_icon1').css('display','block'); 
$('#cat_icon1').fadeIn(function () {
$('#categories1').toggle('slide', {
direction: 'right'
}, 1000);
});
}); 
</script>
