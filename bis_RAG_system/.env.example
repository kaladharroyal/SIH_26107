# ==============================================================================
# BIS RAG System — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and insert your real API credentials below.
# DO NOT commit .env with active API keys to Git.
# ==============================================================================

# LLM Provider Selection: "gemini", "openai", or "mock"
LLM_PROVIDER=gemini

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Configuration (Optional alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Guardrail Confidence Threshold (Default: 0.45)
CONFIDENCE_THRESHOLD=0.45

# Qdrant Cloud Vector Database Configuration
QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=bis_chunks_bge_m3_v1
